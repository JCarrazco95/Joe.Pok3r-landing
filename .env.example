# URL absoluta del sitio. La usan las imágenes de Open Graph (WhatsApp e
# Instagram no resuelven rutas relativas), el canonical y el sitemap.
#
# Local: se puede dejar vacía, cae en http://localhost:3000
# Producción: https://joe-pok3r-landing.vercel.app — y el día que exista,
# https://joepok3r.com
NEXT_PUBLIC_SITE_URL=

# ── Feeds sociales (fase 3) ────────────────────────────────────────────────
# Todas son OPCIONALES y viven solo en las variables de entorno de Vercel.
# Sin ellas, la red correspondiente cae al contenido manual (lib/social/manual.ts).

# YouTube: ID del canal @Joe.Pok3r. Es público, no un secreto; ya hay un valor
# por defecto en lib/env.ts. Solo se define para sobreescribirlo.
# Cómo sacarlo: página del canal → "Compartir canal" → "Copiar ID del canal".
YOUTUBE_CHANNEL_ID=

# Kick: credenciales de la app (https://docs.kick.com/getting-started/kick-apps-setup)
# y slug del canal (por defecto joe-pok3r, https://kick.com/joe-pok3r).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CHANNEL_SLUG=

# Instagram (Graph API) — APAGADO. Solo aplica si algún día se liga una Página
# de Facebook. Con INSTAGRAM_AUTO distinto de "true" se ignora el token.
INSTAGRAM_AUTO=
INSTAGRAM_ACCESS_TOKEN=

# ── Estado en vivo (fase 5) ────────────────────────────────────────────────
# Usa las mismas KICK_CLIENT_ID / KICK_CLIENT_SECRET / KICK_CHANNEL_SLUG de
# arriba. Sin ellas el aviso cae al interruptor manual (`enVivo` en
# lib/joe-poker.ts) y no se muestra reproductor.
#
# SOLO PARA DESARROLLO LOCAL: "en-vivo" o "apagado" simula el estado de Kick sin
# tocar la red. Se ignora en producción (NODE_ENV=production). Déjala vacía en
# Vercel.
EN_VIVO_SIMULADO=
